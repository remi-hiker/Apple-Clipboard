<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>ClipboardManager</string>

    <key>CFBundleDisplayName</key>
    <string>Clipboard Manager</string>

    <key>CFBundleIdentifier</key>
    <string>com.yourname.ClipboardManager</string>

    <key>CFBundleVersion</key>
    <string>1</string>

    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>

    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <key>CFBundleExecutable</key>
    <string>ClipboardManager</string>

    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>

    <!-- Run as a menu-bar-only app (no Dock icon) -->
    <key>LSUIElement</key>
    <true/>

    <!-- Allow running on Apple Silicon natively -->
    <key>LSArchitecturePriority</key>
    <array>
        <string>arm64</string>
        <string>x86_64</string>
    </array>

    <!-- Privacy usage descriptions shown in System Settings and during App Review -->
    <key>NSAccessibilityUsageDescription</key>
    <string>Clipboard Manager uses Accessibility to paste your chosen clipboard item directly into the active app — saving you the extra click.</string>

    <key>NSAppleEventsUsageDescription</key>
    <string>Clipboard Manager needs this to send paste commands to other applications on your behalf.</string>

    <!-- Human Interface Guidelines: copyright shown in the About panel -->
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026. All rights reserved.</string>
</dict>
</plist>
