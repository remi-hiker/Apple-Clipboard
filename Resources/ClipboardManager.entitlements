<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for Mac App Store distribution -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Allows CGEvent keyboard simulation (⌘V paste) once the user grants
         Accessibility permission via System Settings. The onboarding flow
         guides users through this one-time step. -->
    <key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
    <array/>
</dict>
</plist>
